{
  "manifest_version": 3,
  "name": "Shopee Price History & Fake Sale Detector",
  "version": "1.8.0",
  "description": "Soi lịch sử giá thật vs giá ảo 30/90 ngày và cảnh báo bẫy giá Shopee.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://shopee.vn/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Shopee Price Tracker",
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.svg"
  },
  "icons": {
    "128": "icons/icon128.svg"
  }
}
